# =====================================================================
# .gitignore para el proyecto completo (Root / Raíz)
# Cubre Backend (Python/FastAPI), Frontend (Node/React/Vite) y Sistema
# =====================================================================

# ---------------------------------------------------------------------
# 1. Variables de entorno y secretos (¡CRÍTICO: No subir claves de API!)
# ---------------------------------------------------------------------
.env
.env.*
!.env.example
backend/.env
backend/.env.*
!backend/.env.example
frontend/.env.local
frontend/.env.*.local

# ---------------------------------------------------------------------
# 2. Backend - Entornos virtuales de Python
# ---------------------------------------------------------------------
.venv/
venv/
env/
ENV/
env.bak/
venv.bak/
backend/.venv/
backend/venv/

# ---------------------------------------------------------------------
# 3. Backend - Caché de Python y binarios
# ---------------------------------------------------------------------
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

# ---------------------------------------------------------------------
# 4. Backend - Bases de datos locales y vectores (ChromaDB)
# ---------------------------------------------------------------------
backend/chroma_db/
chroma_db/
*.sqlite3
*.sqlite3-journal

# ---------------------------------------------------------------------
# 5. Frontend - Dependencias y compilación (Node.js / Vite / React)
# ---------------------------------------------------------------------
node_modules/
frontend/node_modules/
frontend/dist/
frontend/dist-ssr/
.pnp
.pnp.js
.vite/
frontend/node_modules/.vite/
frontend/node_modules/.vite-temp/

# ---------------------------------------------------------------------
# 6. Logs y temporales
# ---------------------------------------------------------------------
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# ---------------------------------------------------------------------
# 7. Editores e IDEs
# ---------------------------------------------------------------------
.vscode/*
!.vscode/extensions.json
.idea/
*.sublime-project
*.sublime-workspace
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# ---------------------------------------------------------------------
# 8. Archivos del Sistema Operativo (Windows, macOS, Linux)
# ---------------------------------------------------------------------
Thumbs.db
Thumbs.db:encryptable
ehthumbs.db
ehthumbs_vista.db
[Dd]esktop.ini
$RECYCLE.BIN/
.DS_Store
.AppleDouble
.LSOverride
._*

